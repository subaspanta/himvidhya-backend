# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/himvidhya

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Client
CLIENT_URL=http://localhost:3000
CLIENT_APP_DOMAIN=localhost

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_SENDER_USER=your-email@gmail.com
EMAIL_SENDER_PASSWORD=your-app-password

# Object Storage (S3-compatible - MinIO locally via docker-compose.yml, R2 in production)
S3_ENDPOINT=http://localhost:9000
# Presigned URLs are consumed by the browser and must be signed against a
# browser-reachable host - only differs from S3_ENDPOINT under Docker, where
# the server reaches MinIO at http://minio:9000 internally.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=himvidhya-materials
S3_REGION=us-east-1

# Error Tracking
SENTRY_DSN=
